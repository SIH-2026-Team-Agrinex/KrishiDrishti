# ====================================================================
# KrishiDrishti AI - Frontend Environment Configuration Template
# ====================================================================

VITE_APP_TITLE="KrishiDrishti AI | Smart Crop Intelligence"
VITE_APP_VERSION="1.0.0"

# Mode:
# Set to "false" to connect to your live FastAPI Backend & Cloud Database
# Set to "true" to use standalone offline browser IndexedDB mode
VITE_USE_LOCAL_DB=false

# Central API Base URL (When deployed, set to your live backend URL, e.g. https://xxxx.hf.space/api)
# NOTE: All sub-routes (/crop-analysis, /history, /chat, etc.) automatically derive from this!
VITE_API_BASE_URL=http://localhost:8000/api

# Weather Service Provider (Free fallback without API key)
VITE_ENABLE_LIVE_OPEN_METEO_FALLBACK=true

# Real-Time LLM Model API Keys (Optional on frontend if provided on backend)
VITE_GROQ_API_KEY=""
VITE_GEMINI_API_KEY=""
